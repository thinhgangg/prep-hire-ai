# One model family per provider
GROQ_MODEL="openai/gpt-oss-120b"
CLOUDFLARE_MODEL="@cf/qwen/qwen3-30b-a3b-fp8"
INCEPTION_MODEL="mercury-2.5"
OPENTYPHOON_MODEL="typhoon-v2.5-30b-a3b-instruct"
OLLAMA_CLOUD_MODEL="gemma4:31b"
NVIDIA_NEMOTRON_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Optional soft stop per provider. Zero means rely on provider quota responses.
DATASET_PROVIDER_TOKEN_BUDGET=0

# Realtime interview inference (local trained artifacts)
INTERVIEW_MULTI_PROVIDER_ENABLED=true
INTERVIEW_QUESTION_CANDIDATE_COUNT=4
TTS_PREWARM_ENABLED=true
TTS_PREWARM_URL=http://localhost:8000/api/v1/tts/prewarm
TTS_PREWARM_NOTIFY_TIMEOUT_SECONDS=3
INTERVIEW_QUESTION_RANKER_ARTIFACT="artifacts/weak_supervision/v1_1/question_pairwise_ranker_v2.joblib"
INTERVIEW_ANSWER_SCORER_ARTIFACT="artifacts/weak_supervision/v1_1/candidate_answer_scorer.joblib"

# Existing application options
GEMINI_API_KEY="paste_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
CV_AI_ENRICHMENT_ENABLED=true
RESEARCH_PSEUDONYM_SALT="replace_with_a_random_private_value"
JWT_ACCESS_SECRET="replace_with_a_random_private_value"
JWT_SECRET="replace_with_same_jwt_secret_as_prep_hire_be"
JWT_ACCESS_EXPIRES_IN="15m"
INTERNAL_SERVICE_SECRET="replace_with_same_internal_secret_as_prep_hire_be"
